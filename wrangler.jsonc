{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legalengineering-web",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  // Web beží len na vlastnej doméne; *.workers.dev a Preview URLs sú vypnuté (duplicitný obsah).
  "workers_dev": false,
  "preview_urls": false,
  // Centrálne meranie zdrojov, Worker bez verejnej adresy.
  "services": [{ "binding": "MERANIE", "service": "web-meranie" }],
  // Bez invocation logov: pri meraní nesmú vznikať záznamy o požiadavkách s IP a hlavičkami.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  // Statický web z koreňa repa. Čo sa NEMÁ nasadiť, je v .assetsignore.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Len merané stránky, presná zhoda. Súbory, PWA aj presmerovania ostávajú bez Workera.
    "run_worker_first": ["/", "/en/", "/hypo/", "/trovy/", "/konverzia/", "/vygumovanie/", "/pi-poem/"]
  }
}
